<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>BbQ.Cqrs.Outcome.FluentValidation</PackageId>
    <Version>1.3.0</Version>
    <PackageReleaseNotes>General availability: composed mediator and Outcome validation registration through assembly scanning or source generation, optional asynchronous FluentValidation integration and scoped issue mapping. See https://github.com/JeanMarcMbouma/Outcome/blob/master/docs/release-cqrs-1.3.0.md</PackageReleaseNotes>
    <Authors>Jean</Authors>
    <Description>Async FluentValidation adapter for BbQ.Cqrs Outcome validation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/JeanMarcMbouma/Outcome</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BbQ.Cqrs.Outcome/BbQ.Cqrs.Outcome.csproj" />
    <PackageReference Include="FluentValidation" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>

