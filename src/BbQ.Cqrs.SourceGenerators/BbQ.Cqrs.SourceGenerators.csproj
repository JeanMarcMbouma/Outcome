<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    
    <!-- Packaging settings for the analyzer -->
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IncludeBuildOutput>true</IncludeBuildOutput>
    
    <!-- Critical: Output analyzer to the correct NuGet package path -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    
    <!-- Package metadata -->
    <PackageId>BbQ.Cqrs.SourceGenerators</PackageId>
    <Version>1.3.0-preview.4</Version>
    <PackageReleaseNotes>Adds composed mediator and Outcome validation registration through assembly scanning or source generators, shared issue mapping and scoped, idempotent registrations. See https://github.com/JeanMarcMbouma/Outcome/blob/master/docs/release-cqrs-1.3.0-preview.4.md</PackageReleaseNotes>
    <Authors>Jean</Authors>
    <Company>JM Mbouma</Company>
    <Description>Source generators for BbQ.Cqrs - Automatically generates handler registration and boilerplate code for CQRS pattern.</Description>
    <PackageTags>cqrs mediator sourceGenerator roslyn codegen</PackageTags>
    <RepositoryUrl>https://github.com/JeanMarcMbouma/Outcome</RepositoryUrl>
    <PackageProjectUrl>https://github.com/JeanMarcMbouma/Outcome</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <LicenseExpression>MIT</LicenseExpression>
    <Title>BbQ.Cqrs Source Generators</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Source Link settings -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include README in the NuGet package -->
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Ensure analyzer is included in the correct NuGet package structure -->
  <ItemGroup>
    <None Include="$(OutputPath)BbQ.Cqrs.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>

