<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>BbQ.Outcome.SystemTextJson</PackageId>
    <Version>1.2.0</Version>
    <PackageReleaseNotes>General availability: typed and heterogeneous results, async composition, dependency-free retries, generated error helpers and optional HTTP, JSON and diagnostics integrations. See https://github.com/JeanMarcMbouma/Outcome/blob/master/docs/release-outcome-1.2.0.md</PackageReleaseNotes>
    <Authors>Jean</Authors>
    <Description>Explicit, Native AOT-compatible System.Text.Json contracts for BbQ.Outcome.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/JeanMarcMbouma/Outcome</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BbQ.Outcome/BbQ.Outcome.csproj" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
