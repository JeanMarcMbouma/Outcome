<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>BbQ.Cqrs.Outcome</PackageId>
    <Version>1.3.0-preview.4</Version>
    <PackageReleaseNotes>Adds composed mediator and Outcome validation registration through assembly scanning or source generators, optional FluentValidation discovery, shared issue mapping and scoped, idempotent registrations. See https://github.com/JeanMarcMbouma/Outcome/blob/master/docs/release-cqrs-1.3.0-preview.4.md</PackageReleaseNotes>
    <Authors>Jean</Authors>
    <Description>Optional type-safe validation behaviors and response factories for BbQ.Cqrs and BbQ.Outcome.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/JeanMarcMbouma/Outcome</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BbQ.Cqrs/BbQ.Cqrs.csproj" />
    <ProjectReference Include="../BbQ.Outcome/BbQ.Outcome.csproj" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>

