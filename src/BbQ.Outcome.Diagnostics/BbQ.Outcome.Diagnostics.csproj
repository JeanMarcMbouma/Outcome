<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PackageId>BbQ.Outcome.Diagnostics</PackageId>
    <Version>1.2.0-preview.2</Version>
    <Authors>Jean</Authors>
    <Description>Opt-in structured logging and Activity instrumentation for BbQ.Outcome.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/JeanMarcMbouma/Outcome</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../BbQ.Outcome/BbQ.Outcome.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
