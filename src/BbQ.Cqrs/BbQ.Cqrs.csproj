<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net481</TargetFrameworks>

    <PackageId>BbQ.Cqrs</PackageId>
    <Version>1.3.0-preview.4</Version>
    <PackageReleaseNotes>Adds composed mediator and Outcome validation registration through assembly scanning or source generators, optional FluentValidation discovery, shared issue mapping and scoped, idempotent registrations. See https://github.com/JeanMarcMbouma/Outcome/blob/master/docs/release-cqrs-1.3.0-preview.4.md</PackageReleaseNotes>
    <Authors>Jean</Authors>
    <Company>JM Mbouma</Company>
    <Description>A lightweight mediator implementation.</Description>
    <PackageTags>cqrs mediator</PackageTags>
    <RepositoryUrl>https://github.com/JeanMarcMbouma/Outcome</RepositoryUrl>
    <PackageProjectUrl>https://github.com/JeanMarcMbouma/Outcome</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <LicenseExpression>MIT</LicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build settings -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>BbQ.Cqrs</RootNamespace>

    <!-- Source Link settings -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>BbQ.Cqrs</Title>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Scrutor" />
  </ItemGroup>

  <ItemGroup>
    <!-- Include README in the NuGet package -->
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>

